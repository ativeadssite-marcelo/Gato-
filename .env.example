# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Project ref provided by user: tfyocjdozttclxgipexu
SUPABASE_PROJECT_REF="tfyocjdozttclxgipexu"
SUPABASE_URL="https://tfyocjdozttclxgipexu.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="company-logos"
SUPABASE_DB_HOST="db.tfyocjdozttclxgipexu.supabase.co"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_USER="postgres"
SUPABASE_DB_PASSWORD=""
SUPABASE_DB_NAME="postgres"

# ==========================================================================
# SEGURANÇA GATO (obrigatório em produção — o servidor falha ao iniciar sem)
# ==========================================================================
# Segredo HMAC mínimo de 32 caracteres para assinar tokens de sessão.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GATO_SESSION_SECRET=""

# Senha master do superadmin (mínimo 8 caracteres) para elevação de privilégio
# nas telas administrativas (/superadmin, governança RBAC). Verificada no
# servidor; NUNCA usar variáveis VITE_* (que vão para o bundle do navegador).
GATO_MASTER_PASSWORD=""

# Chave server-to-server para webhooks de marketplaces/gateways.
# Enquanto vazia ou com menos de 16 caracteres, os webhooks ficam FECHADOS.
GATO_INGEST_API_KEY=""

# Duração da sessão (minutos, padrão 480 = 8h) e da simulação de persona.
GATO_SESSION_TTL_MINUTES="480"
GATO_IMPERSONATION_TTL_MINUTES="60"

# Habilita contas de demonstração (senha em GATO_DEMO_PASSWORD).
# Em produção defina "false" e cadastre contas reais via GATO_USERS_JSON.
GATO_ALLOW_DEMO_LOGIN="false"
GATO_DEMO_PASSWORD=""

# Contas de usuários em JSON (usada pelo seed do servidor), ex.:
# GATO_USERS_JSON='[{"email":"admin@suaempresa.com","password":"...","roleCode":"super_admin"}]'
GATO_USERS_JSON=""

# Somente defina "true" atrás de um proxy reverso de confiança
# (ex.: nginx/Cloud Run) — faz o servidor aceitar X-Forwarded-For.
GATO_TRUST_PROXY="false"

# Tenant padrão para dados sem dono explícito (seed/demo).
GATO_DEFAULT_TENANT_ID="cmtt58e6o0000ju346a0g6s32"

# ==========================================================================
# COBRANÇA (GATEWAY ASAAS) — opcional; sem chave, a assinatura fica "ativa"
# em modo aguardando setup manual do financeiro (sem falso positivo de cobrança).
# ==========================================================================
# Chave da API do Asaas (gerada no painel Asaas > Integrações > API).
ASAAS_API_KEY=""
# Ambiente do gateway: "sandbox" (padrão) ou "production".
ASAAS_ENV="sandbox"
# Token do webhook (mín. 16 caracteres) configurado no painel Asaas.
# Enquanto vazio, o endpoint /api/billing/webhooks/asaas permanece FECHADO.
ASAAS_WEBHOOK_TOKEN=""

# ==========================================================================
# E-MAIL TRANSACIONAL (opcional) — sem provedor, usa o adaptador "console"
# (registra o e-mail em log JSON; útil em dev/demo).
# ==========================================================================
# Chave da API do SendGrid. Se vazia, o envio é logado no console.
SENDGRID_API_KEY=""
SENDGRID_FROM="noreply@gatosistemas.com.br"
# Intervalo do cron de vencimentos/trial em minutos (padrão 60).
GATO_BILLING_CRON_MINUTES="60"
# Fila de e-mail: máximo de tentativas (padrão 3) e backoff inicial em ms (padrão 5000).
GATO_EMAIL_MAX_RETRIES="3"
GATO_EMAIL_BACKOFF_MS="5000"

# CLIENT-SIDE SUPABASE CONFIGURATION:
VITE_SUPABASE_URL="https://tfyocjdozttclxgipexu.supabase.co"
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_STORAGE_BUCKET="company-logos"

