%% =====================================================================
%% Arquitetura-alvo do GATO SaaS (fluxograma de referência)
%%
%% Nota de adaptação: o GATO implementa um modelo de papéis mais granular
%% que o desenho genérico abaixo. Mapeamento real (server/rbacEngine.ts):
%%   - "Dono do SaaS"        -> super_admin
%%   - Equipe SaaS           -> saas_financeiro / saas_fiscal / saas_suporte
%%                             / saas_config / saas_cs
%%   - "Admin Tenant"        -> tenant_admin
%%   - "Usuário comum"       -> tenant_user / tenant_readonly
%% =====================================================================

flowchart TD
    A[Usuário acessa o SaaS] --> B{Tipo de acesso?}

    B -->|Dono do SaaS| C[Super Admin Panel]
    B -->|Empresa cliente| D[Admin Tenant Panel]
    B -->|Usuário comum| E[App do Tenant]

    %% SUPER ADMIN
    C --> C1[CRUD de Planos]
    C1 --> C1a[Definir limites: storage, clientes, usuários, trial_dias]
    C --> C2[Gestão de Tenants]
    C2 --> C2a[Ativar / Suspender / Cancelar]
    C2 --> C2b[Alterar plano manualmente]
    C2 --> C2c[Impersonar tenant com log de auditoria]
    C --> C3[Dashboard Financeiro]
    C3 --> C3a[MRR, Churn, Inadimplência, Trials]
    C --> C4[Auditoria e Logs]
    C --> C5[Configurações globais: templates de e-mail, integrações]

    %% ONBOARDING
    D --> F[Cadastro da empresa]
    F --> F1[Cria tenant no banco]
    F1 --> F2[Cria assinatura trial]
    F2 --> F3[status = trial, trial_fim = agora + plano.trial_dias]
    F3 --> G[Envia e-mail de boas-vindas + guia de setup]

    %% USO E LIMITES
    G --> H[Tenant usa o sistema]
    H --> I{Verificação de quotas}
    I -->|Storage OK| H1[Aceita upload]
    I -->|Storage excedido| I1[Bloqueia / Sugere upgrade]
    I -->|Clientes OK| H2[Cadastra cliente]
    I -->|Clientes excedidos| I2[Bloqueia / Sugere upgrade]
    I -->|Usuários OK| H3[Adiciona usuário]
    I -->|Usuários excedidos| I3[Bloqueia / Sugere upgrade]

    %% TRIAL E COBRANÇA
    F3 --> J{Trial ativo?}
    J -->|Faltam 3 dias| J1[E-mail: trial acabando]
    J -->|Faltam 1 dia| J2[E-mail: último aviso]
    J -->|Expirou| J3{Método de pagamento cadastrado?}
    J3 -->|Sim| K[Cria assinatura no Gateway]
    J3 -->|Não| J4[status = expired → somente leitura → suspenso]

    K --> K1[Gateway: Stripe / Asaas / Pagar.me / Mercado Pago]
    K1 --> K2[Salva gateway_customer_id + gateway_subscription_id]
    K2 --> L[Webhooks do Gateway]

    %% WEBHOOKS
    L --> L1{Evento?}
    L1 -->|invoice.paid| L2[Fatura = paga / assinatura = active]
    L1 -->|invoice.payment_failed| L3[status = past_due + e-mail cobrança]
    L1 -->|subscription.canceled| L4[status = canceled + bloqueia acesso]
    L2 --> M[Atualiza próxima cobrança]

    %% CRON DIÁRIO
    N[Cron diário] --> N1[Busca faturas abertas/vencidas]
    N1 --> N2{Vencimento?}
    N2 -->|Em 3 dias| N3[E-mail: lembrete]
    N2 -->|Amanhã| N4[E-mail: amanhã]
    N2 -->|Hoje| N5[E-mail: vence hoje]
    N2 -->|Vencida 1/3/7 dias| N6[E-mail: regularize + risco de suspensão]
    N3 --> O[Log de envio]
    N4 --> O
    N5 --> O
    N6 --> O

    %% SEGURANÇA
    P[Middleware de Auth / RBAC] --> P1[super_admin]
    P --> P2[tenant_admin]
    P --> P3[usuario_comum]
    P1 --> Q[Log de auditoria em toda ação sensível]
    P2 --> Q
    P3 --> Q

    %% ADMIN TENANT
    D --> R[Admin Tenant vê:]
    R --> R1[Uso atual: storage, clientes, usuários]
    R --> R2[Plano + próxima cobrança + faturas]
    R --> R3[Atualizar cartão / Upgrade / Downgrade]
    R --> R4[Gerenciar usuários e permissões]
    R --> R5[Avisos de vencimento]
